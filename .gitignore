# VibeZoo .gitignore

# Node
node_modules/
extension/out/
extension/dist/

# Python
__pycache__/
*.pyc
*.pyo

# Go
mcp-servers/bin/
mcp-servers/build/

# VS Code
.vscode/
*.vsix

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# Build

# Test artifacts
test_output.png
analyzed_image.jpg
*.jpg
*.png
dist/
build/

# Test scripts (temporary)
test_*.py
_insert_*.py
_debug*
_fix_*.py
_fix_*.txt

# VibeZoo data (user local)
.zoo-code/

# VSIX packaging cruft
extension/--out/
extension/-Force/
extension/npx/
extension/package/
extension/vsce/
$null
"test_output.png"  

# Temp/debug files from VibeZoo session
*.bak
*.bak3
*.v2bak
*_result.txt
line*.txt
global_*.txt
check_*.txt