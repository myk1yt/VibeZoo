{
  "name": "vibezoo",
  "displayName": "%vibezoo.displayName%",
  "description": "%vibezoo.description%",
  "version": "0.14.2",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibezoo/vibezoo"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibezoo.selfCheck",
        "title": "%vibezoo.selfCheck.title%"
      },
      {
        "command": "vibezoo.verifyFoundation",
        "title": "%vibezoo.verifyFoundation.title%"
      },
      {
        "command": "vibezoo.reconnectCrow",
        "title": "%vibezoo.reconnectCrow.title%"
      },
      {
        "command": "vibezoo.instantRewind",
        "title": "%vibezoo.instantRewind.title%"
      },
      {
        "command": "vibezoo.toggleYolo",
        "title": "%vibezoo.toggleYolo.title%"
      },
      {
        "command": "vibezoo.scanProject",
        "title": "%vibezoo.scanProject.title%"
      },
      {
        "command": "vibezoo.openWhiteboard",
        "title": "%vibezoo.openWhiteboard.title%"
      },
      {
        "command": "vibezoo.openUIPreview",
        "title": "%vibezoo.openUIPreview.title%"
      },
      {
        "command": "vibezoo.openDashboard",
        "title": "%vibezoo.openDashboard.title%"
      },
      {
        "command": "vibezoo.openDropzone",
        "title": "%vibezoo.openDropzone.title%"
      },
      {
        "command": "vibezoo.toggleFileGuard",
        "title": "%vibezoo.toggleFileGuard.title%"
      },
      {
        "command": "vibezoo.showSessionResume",
        "title": "%vibezoo.showSessionResume.title%"
      },
      {
        "command": "vibezoo.reviewProject",
        "title": "%vibezoo.reviewProject.title%"
      },
      {
        "command": "vibezoo.findBugs",
        "title": "%vibezoo.findBugs.title%"
      },
      {
        "command": "vibezoo.suggestRefactor",
        "title": "%vibezoo.suggestRefactor.title%"
      },
      {
        "command": "vibezoo.generateDocs",
        "title": "%vibezoo.generateDocs.title%"
      },
      {
        "command": "vibezoo.pauseFixLoop",
        "title": "%vibezoo.pauseFixLoop.title%"
      },
      {
        "command": "vibezoo.resumeFixLoop",
        "title": "%vibezoo.resumeFixLoop.title%"
      },
      {
        "command": "vibezoo.abortFixLoop",
        "title": "%vibezoo.abortFixLoop.title%"
      },
      {
        "command": "vibezoo.startWatching",
        "title": "%vibezoo.startWatching.title%"
      },
      {
        "command": "vibezoo.stopWatching",
        "title": "%vibezoo.stopWatching.title%"
      },
      {
        "command": "vibezoo.explainCode",
        "title": "%vibezoo.explainCode.title%"
      },
      {
        "command": "vibezoo.analyzeChanges",
        "title": "%vibezoo.analyzeChanges.title%"
      },
      {
        "command": "vibezoo.reviewPR",
        "title": "%vibezoo.reviewPR.title%"
      },
      {
        "command": "vibezoo.refactorAcrossFiles",
        "title": "%vibezoo.refactorAcrossFiles.title%"
      },
      {
        "command": "vibezoo.learnProject",
        "title": "%vibezoo.learnProject.title%"
      },
      {
        "command": "vibezoo.recallProject",
        "title": "%vibezoo.recallProject.title%"
      },
      {
        "command": "vibezoo.learnPreference",
        "title": "%vibezoo.learnPreference.title%"
      },
      {
        "command": "vibezoo.getPreferences",
        "title": "%vibezoo.getPreferences.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibezoo-sidebar",
          "title": "%viewsContainer.vibezoo-sidebar.title%",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "vibezoo-sidebar": [
        {
          "id": "vibezoo.activeSubagents",
          "name": "%view.vibezoo.activeSubagents.name%",
          "type": "tree",
          "contextualTitle": "VibeZoo Subagents"
        },
        {
          "id": "vibezoo.yoloHistory",
          "name": "%view.vibezoo.yoloHistory.name%",
          "type": "tree",
          "contextualTitle": "VibeZoo YOLO Sessions"
        },
        {
          "id": "vibezoo.sessionResume",
          "name": "%view.vibezoo.sessionResume.name%",
          "type": "tree",
          "contextualTitle": "VibeZoo Session Resume"
        }
      ]
    },
    "configuration": {
      "title": "VibeZoo",
      "properties": {
        "vibezoo.crow.port": {
          "type": "number",
          "default": 9020,
          "description": "%vibezoo.crow.port.description%"
        },
        "vibezoo.crow.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.crow.autoReconnect.description%"
        },
        "vibezoo.yolo.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.yolo.enabled.description%"
        },
        "vibezoo.yolo.rewindShortcut": {
          "type": "string",
          "default": "ctrl+shift+z",
          "description": "%vibezoo.yolo.rewindShortcut.description%"
        },
        "vibezoo.build.silentMode": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.build.silentMode.description%"
        },
        "vibezoo.build.autoFix": {
          "type": "boolean",
          "default": false,
          "description": "%vibezoo.build.autoFix.description%"
        },
        "vibezoo.build.autoFixMaxAttempts": {
          "type": "number",
          "default": 3,
          "description": "%vibezoo.build.autoFixMaxAttempts.description%"
        },
        "vibezoo.scout.port": {
          "type": "number",
          "default": 9022,
          "description": "%vibezoo.scout.port.description%"
        },
        "vibezoo.reviewer.port": {
          "type": "number",
          "default": 9023,
          "description": "%vibezoo.reviewer.port.description%"
        },
        "vibezoo.tester.port": {
          "type": "number",
          "default": 9024,
          "description": "%vibezoo.tester.port.description%"
        },
        "vibezoo.deepAnalyzer.port": {
          "type": "number",
          "default": 9026,
          "description": "%vibezoo.deepAnalyzer.port.description%"
        },
        "vibezoo.context.showFreshness": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.context.showFreshness.description%"
        },
        "vibezoo.session.autoResume": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.session.autoResume.description%"
        },
        "vibezoo.visual.whiteboardEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.visual.whiteboardEnabled.description%"
        },
        "vibezoo.visual.uiPreviewEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.visual.uiPreviewEnabled.description%"
        },
        "vibezoo.emotion.detectionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%vibezoo.emotion.detectionEnabled.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "vibezoo.showSessionResume",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "vibezoo.instantRewind",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus"
      },
      {
        "command": "vibezoo.openWhiteboard",
        "key": "ctrl+shift+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vibezoo.instantRewind",
          "when": "view == vibezoo.yoloHistory && viewItem == yoloSnapshot",
          "group": "1_rewind"
        }
      ],
      "editor/context": [
        {
          "command": "vibezoo.reviewProject",
          "group": "vibezoo@1",
          "when": "explorerViewletVisible"
        },
        {
          "command": "vibezoo.findBugs",
          "group": "vibezoo@2",
          "when": "explorerViewletVisible"
        },
        {
          "command": "vibezoo.suggestRefactor",
          "group": "vibezoo@3",
          "when": "explorerViewletVisible"
        },
        {
          "command": "vibezoo.generateDocs",
          "group": "vibezoo@4",
          "when": "explorerViewletVisible"
        }
      ],
      "commandPalette": [
        {
          "command": "vibezoo.reviewProject",
          "when": "never"
        },
        {
          "command": "vibezoo.findBugs",
          "when": "never"
        },
        {
          "command": "vibezoo.suggestRefactor",
          "when": "never"
        },
        {
          "command": "vibezoo.generateDocs",
          "when": "never"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "l10n:export": "npx @vscode/l10n-dev export --outDir ./l10n ./src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  },
  "l10n": "./l10n"
}
